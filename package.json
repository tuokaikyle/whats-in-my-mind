{
  "name": "whats-in-my-mind",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@trpc/server": "^11.5.0",
      "better-auth": "^1.4.5",
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@trpc/client": "^11.5.0",
      "drizzle-orm": "^0.45.0"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @whats-in-my-mind/db db:push",
    "db:studio": "turbo -F @whats-in-my-mind/db db:studio",
    "db:generate": "turbo -F @whats-in-my-mind/db db:generate",
    "db:migrate": "turbo -F @whats-in-my-mind/db db:migrate",
    "db:migrate:dev": "turbo -F @whats-in-my-mind/db db:migrate:dev",
    "db:migrate:prod": "turbo -F @whats-in-my-mind/db db:migrate:prod",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
    "deploy:server": "turbo -F server deploy",
    "deploy:web": "cd apps/web && bun run build && wrangler pages deploy dist",
    "deploy": "bun run build && bun run deploy:server"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.2.6"
  },
  "packageManager": "bun@1.2.15"
}
