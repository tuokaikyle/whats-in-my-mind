{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@trpc/server": "catalog:",
    "@whats-in-my-mind/api": "workspace:*",
    "@whats-in-my-mind/auth": "workspace:*",
    "@whats-in-my-mind/db": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "react": "19.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "@whats-in-my-mind/config": "workspace:*",
    "tsdown": "^0.16.5",
    "typescript": "^5.8.2",
    "wrangler": "4"
  }
}
