{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_DEV",
        "DATABASE_URL_DEV_DIRECT",
        "DATABASE_URL_DIRECT",
        "DATABASE_URL_PRODUCTION",
        "DATABASE_URL_PRODUCTION_DIRECT",
        "DATABASE_URL_MIGRATE",
        "DB_TARGET"
      ],
      "cache": false,
      "persistent": true
    },
    "db:migrate:dev": {
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_DEV",
        "DATABASE_URL_DEV_DIRECT",
        "DATABASE_URL_DIRECT",
        "DATABASE_URL_PRODUCTION",
        "DATABASE_URL_PRODUCTION_DIRECT",
        "DATABASE_URL_MIGRATE",
        "DB_TARGET"
      ],
      "cache": false,
      "persistent": true
    },
    "db:migrate:prod": {
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_DEV",
        "DATABASE_URL_DEV_DIRECT",
        "DATABASE_URL_DIRECT",
        "DATABASE_URL_PRODUCTION",
        "DATABASE_URL_PRODUCTION_DIRECT",
        "DATABASE_URL_MIGRATE",
        "DB_TARGET"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    }
  }
}
